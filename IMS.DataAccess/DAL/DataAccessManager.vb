        ' Here goes codes for Get Reference
        Public Function GetReference() As String

            Try
                ''TODO: Lock , get , set - yearly "Reference" for INCIDENT.

                Dim lstReference As New List(Of DTO.Reference)
                Dim referenceNO As Integer = 0
                Dim refrence As String = String.Empty
                Dim objReference As New DTO.Reference

                lstReference = GetFilteredReference("ReferenceYear = '" + Date.Now.Year.ToString() + "' ").Cast(Of DTO.Reference).ToList()
                If lstReference.Count > 0 Then

                    lstReference(0).ReferenceNo += 1
                    referenceNO = lstReference(0).ReferenceNo
                    'Update Reference Table.
                    UpdateReference(lstReference(0))
                Else
                    InsertCurrentReference()
                    referenceNO = 1

                End If

                refrence = referenceNO.ToString() + "/" + Date.Now.ToString("yy")

                Return refrence

            Catch exp As Exception
                Throw exp
            End Try
        End Function


